[Unit]
Description=Rescue Bridge TLS Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rescuebridge
Group=rescuebridge
WorkingDirectory=/opt/rescue-bridge
ExecStart=/usr/bin/python3 /opt/rescue-bridge/relay_server.py --listen 0.0.0.0 --port 8443 --registry /opt/rescue-bridge/state/devices.json --cert /opt/rescue-bridge/state/relay.crt --key /opt/rescue-bridge/state/relay.key
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/rescue-bridge

[Install]
WantedBy=multi-user.target
